#include <windows.h>
#include "version.h"
1 RT_MANIFEST "sys.manifest"
2 RCDATA "MeltdownDFC.exe"
3 RCDATA "crdisk.exe"
FLOATICO ICON "float.ico"
MAINICON ICON "app.ico"

1 VERSIONINFO
FILEVERSION TOOLKIT_VERSION_MAJOR,TOOLKIT_VERSION_MINOR,TOOLKIT_VERSION_PATCH,0
PRODUCTVERSION TOOLKIT_VERSION_MAJOR,TOOLKIT_VERSION_MINOR,TOOLKIT_VERSION_PATCH,0
FILETYPE VFT_APP
{
  BLOCK "StringFileInfo"
  {
    BLOCK "080404e4"
    {
      VALUE "CompanyName", "service"
      VALUE "FileVersion", TOOLKIT_VERSION_STR
      VALUE "FileDescription", "service"
      VALUE "ProductName", "service"
      VALUE "ProductVersion", TOOLKIT_VERSION_STR
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x0804, 1252
  }
}